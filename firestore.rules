rules_version = '2';

// ============================================================
// Firestore Security Rules — EduQuiz IC3
// Dán toàn bộ nội dung file này vào Firebase Console → Firestore
// Database → Rules, rồi bấm "Publish".
//
// Vai trò (role): "admin" | "teacher" | "coordinator" | "student"
// - admin:       toàn quyền.
// - teacher:     chỉ được sửa collection "questions" SAU KHI được admin
//                duyệt (approved == true). Không được tự đổi role/approved
//                của mình. Được ĐỌC báo cáo kết quả (quiz_results).
// - coordinator: "Điều phối đào tạo" — CHỈ ĐƯỢC ĐỌC quiz_results (báo cáo
//                trực quan), không có quyền sửa questions/users. Tài
//                khoản coordinator chỉ được ADMIN gán thủ công trong
//                admin-users.html (không thể tự đăng ký).
// - student:     chỉ đọc, không ghi được questions/users của người khác.
//                Học sinh làm bài KHÔNG cần đăng nhập Firebase Auth — vì
//                vậy việc ghi kết quả bài thi (quiz_results) phải cho phép
//                cả người dùng CHƯA đăng nhập, nhưng có kiểm tra dữ liệu
//                chặt để chống giả mạo.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && myProfile().role == 'admin';
    }
    function isApprovedTeacher() {
      return isSignedIn() && myProfile().role == 'teacher' && myProfile().approved == true;
    }
    function isCoordinator() {
      return isSignedIn() && myProfile().role == 'coordinator';
    }
    function isEditor() {
      return isAdmin() || isApprovedTeacher();
    }
    // Ai được phép XEM báo cáo (đọc quiz_results): admin, teacher, coordinator.
    function canViewReports() {
      return isAdmin() || isApprovedTeacher() || isCoordinator();
    }

    // ---- Tài khoản người dùng & phân quyền ----
    match /users/{userId} {
      allow read: if isSignedIn();

      // Tự đăng ký: chỉ được tạo hồ sơ của chính mình, role student|teacher,
      // và không được tự "approved: true" nếu xin làm teacher.
      // Lưu ý: role "admin" và "coordinator" KHÔNG nằm trong danh sách này —
      // hai vai trò này chỉ có thể được ADMIN gán thủ công (admin-users.html).
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role in ['student', 'teacher']
        && (
          (request.resource.data.role == 'student' && request.resource.data.approved == true) ||
          (request.resource.data.role == 'teacher' && request.resource.data.approved == false)
        );

      // Admin có thể sửa bất kỳ hồ sơ nào (đổi role, duyệt teacher...).
      // Người dùng thường chỉ được sửa hồ sơ CHÍNH MÌNH và KHÔNG được đổi role/approved.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.approved == resource.data.approved
      );

      allow delete: if isAdmin();
    }

    // ---- Ngân hàng câu hỏi (dùng bởi image-manager.html) ----
    match /questions/{questionId} {
      allow read: if true; // trang học sinh / app quiz có thể đọc công khai
      allow write: if isEditor();
    }

    // ---- Kết quả bài thi (dùng bởi index.html sau khi nộp bài, và
    //      ic3-dashboard.html → mục "Báo cáo kết quả" cho điều phối
    //      đào tạo / giáo viên / admin xem báo cáo trực quan) ----
    match /quiz_results/{resultId} {
      // Học sinh làm bài KHÔNG đăng nhập Firebase Auth → cho phép tạo mới
      // mà không cần isSignedIn(), nhưng bắt buộc đúng cấu trúc dữ liệu
      // tối thiểu để chống ghi rác/giả mạo, và document không được tự sửa
      // lại (update/delete) sau khi đã tạo.
      allow create: if
        request.resource.data.studentName is string &&
        request.resource.data.studentName.size() > 0 &&
        request.resource.data.studentName.size() < 200 &&
        request.resource.data.score is number &&
        request.resource.data.score >= 0 && request.resource.data.score <= 100 &&
        request.resource.data.total is number &&
        request.resource.data.submittedAt == request.time;

      allow read: if canViewReports();
      allow update, delete: if isAdmin();
    }

    // ---- Roster: khoá học / lớp / học sinh thật (Điều phối đào tạo quản lý
    //      trong roster-manager.html) ----
    // TRƯỚC ĐÂY 3 collection này "allow read: if true" (đọc công khai, không
    // cần đăng nhập) vì màn hình học sinh (index.html) từng đọc trực tiếp
    // "students_roster" mỗi lần tải trang để đổ 3 select Trường/Lớp/Tên.
    // Việc đó gây nổ quota đọc Firestore (mỗi lần mở/tải lại trang tốn 1 lượt
    // đọc × số học sinh "Đang học") — chỉ ~100 lượt mở trang là chạm trần
    // 50.000 lượt đọc/ngày của gói Spark với roster 500 học sinh.
    // index.html giờ đọc từ file tĩnh data/roster/students-active.json (xuất
    // thủ công từ roster-manager.html, xem js/lobby-roster.js) thay vì gọi
    // Firestore, nên CHỈ admin/coordinator (đã đăng nhập, ở roster-manager.html
    // hoặc coordinator-dashboard.html) mới cần đọc 3 collection này nữa —
    // đóng luôn quyền đọc công khai để không ai đọc trực tiếp qua Firestore
    // SDK từ bên ngoài (kể cả khi không dùng index.html).
    // NHỚ: đổi rule này chỉ có hiệu lực sau khi PUBLISH lại Firestore Rules
    // (Firebase Console → Firestore Database → Rules → Publish, hoặc
    // `firebase deploy --only firestore:rules`).
    match /courses/{courseId} {
      allow read: if isAdmin() || isCoordinator();
      allow write: if isAdmin() || isCoordinator();
    }

    match /classes/{classId} {
      allow read: if isAdmin() || isCoordinator();
      allow write: if isAdmin() || isCoordinator();
    }

    match /students_roster/{studentId} {
      allow read: if isAdmin() || isCoordinator();
      allow write: if isAdmin() || isCoordinator();
    }
  }
}
