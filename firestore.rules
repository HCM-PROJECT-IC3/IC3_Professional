rules_version = '2';

// Firestore Security Rules — EduQuiz IC3 (project data-ic3)
// Publish: firebase deploy --only firestore:rules --project data-ic3
//
// Vai trò (users/{uid}.role):
//   admin                 toàn quyền.
//   teacher               cần approved == true. Đọc kết quả của các trường trong "schools"
//                         (Admin gán), đọc roster của học sinh có teacherId == mình,
//                         đọc lịch giảng dạy cả đội, sửa lịch của chính mình.
//   coordinator           Điều phối đào tạo: đọc/ghi roster và đọc kết quả trong các trường
//                         thuộc "schools"; không có quyền với teaching_*.
//   school_admin          Quản trị trường: phạm vi như coordinator (theo "schools"), thêm quyền
//                         sửa thông tin liên hệ của trường mình trong schools/{schoolId}.
//   teaching_coordinator  Điều phối giáo viên: đọc mọi teaching_*, ghi
//                         teaching_travel_distances; không có quyền với roster/kết quả.
//   student               không cần tài khoản để làm bài.
// admin/coordinator/school_admin/teaching_coordinator chỉ Admin gán được (admin-users.html).
//
// Chuyển tiếp tên trường → schoolId (docs/architecture/AUDIT-2.0.md §6): hồ sơ có "schools"
// (tên) và "schoolIds" (slug, js/models/school.model.js). Bản ghi thuộc phạm vi nếu tên trường
// nằm trong "schools" HOẶC field schoolId nằm trong "schoolIds".
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Trang học sinh có tự ghi quiz_results không. Bài nộp hiện chỉ lên Google Sheet
    // (js/backend-config.js → quizResults.firestore = 'off'). Đổi sang 'all'/'test-only' thì
    // sửa thành true và publish rules trước khi đẩy web (test backend-consistency kiểm tra).
    function quizResultsOpen() {
      return false;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && myProfile().role == 'admin';
    }
    function isApprovedTeacher() {
      return isSignedIn() && myProfile().role == 'teacher' && myProfile().approved == true;
    }
    function isCoordinator() {
      return isSignedIn() && myProfile().role == 'coordinator';
    }
    function isSchoolAdmin() {
      return isSignedIn() && myProfile().role == 'school_admin';
    }
    // Điều phối đào tạo + Quản trị trường: cùng phạm vi theo "schools".
    function isSchoolStaff() {
      return isCoordinator() || isSchoolAdmin();
    }
    function isTeachingCoordinator() {
      return isSignedIn() && myProfile().role == 'teaching_coordinator';
    }
    function isEditor() {
      return isAdmin() || isApprovedTeacher();
    }
    // Trường được xem: field "schools" do Admin gán. Thiếu/rỗng → không đọc được gì.
    function myTeacherSchools() {
      return isApprovedTeacher() && ('schools' in myProfile()) ? myProfile().schools : [];
    }
    function myStaffSchools() {
      return isSchoolStaff() && ('schools' in myProfile()) ? myProfile().schools : [];
    }
    function mySchoolIds() {
      return ('schoolIds' in myProfile()) ? myProfile().schoolIds : [];
    }
    function inScope(data, nameField, schools) {
      return data[nameField] in schools || (('schoolId' in data) && data.schoolId in mySchoolIds());
    }
    // Query danh sách dùng hàm này phải có where(field, 'in', schools) ở client,
    // nếu không Firestore từ chối cả query.
    function isOwnSchoolField(fieldName) {
      return isAdmin()
        || (isSchoolStaff() && inScope(resource.data, fieldName, myStaffSchools()))
        || (isApprovedTeacher() && inScope(resource.data, fieldName, myTeacherSchools()));
    }
    // students_roster: giáo viên lọc theo teacherId (đủ chặt, khỏi cần composite index
    // teacherId + school); điều phối lọc theo trường.
    function canAccessRosterStudent() {
      return isAdmin()
        || (isSchoolStaff() && inScope(resource.data, 'school', myStaffSchools()))
        || (isApprovedTeacher() && resource.data.teacherId == request.auth.uid);
    }
    // Ghi/xoá roster: chỉ Admin và điều phối của trường đó (giáo viên chỉ đọc).
    function canWriteRosterStudent() {
      return isAdmin()
        || (isSchoolStaff() && inScope(request.resource.data, 'school', myStaffSchools()));
    }
    function canDeleteRosterStudent() {
      return isAdmin()
        || (isSchoolStaff() && inScope(resource.data, 'school', myStaffSchools()));
    }
    // Mã NV (teaching_teachers) Admin gán cho giáo viên.
    function myTeacherCode() {
      return (isApprovedTeacher() && ('teacherCode' in myProfile())) ? myProfile().teacherCode : null;
    }

    // ---- Tài khoản ----
    match /users/{userId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow list: if request.query.limit <= 1000 && (isAdmin() || (
        (isApprovedTeacher() || isSchoolStaff() || isTeachingCoordinator()) &&
        resource.data.role == 'teacher' && resource.data.approved == true
      ));

      // Admin tạo hồ sơ hộ (nhập giáo viên từ Excel). Tự đăng ký: chỉ hồ sơ của mình,
      // role student|teacher, giáo viên chưa được duyệt, không kèm field phân quyền.
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'role', 'approved', 'requestedRole', 'createdAt'
        ])
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.requestedRole in ['student', 'teacher', 'coordinator', 'teaching_coordinator']
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.role == 'student' && request.resource.data.approved == true) ||
          (request.resource.data.role == 'teacher' && request.resource.data.approved == false)
        )
      );

      // Người dùng chỉ tự sửa tên/email.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.approved == resource.data.approved &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email'])
      );

      allow delete: if isAdmin();
    }

    // ---- Danh mục trường (id = schoolId, js/models/school.model.js) ----
    // Admin tạo/đổi tên/ngừng; Quản trị trường chỉ sửa thông tin liên hệ của trường mình.
    match /schools/{schoolId} {
      allow get: if isAdmin() || isSchoolStaff() || isApprovedTeacher() || isTeachingCoordinator();
      allow list: if request.query.limit <= 1000 &&
        (isAdmin() || isSchoolStaff() || isApprovedTeacher() || isTeachingCoordinator());
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly([
          'name', 'status', 'address', 'phone', 'contactName', 'note', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 200 &&
        request.resource.data.status in ['active', 'inactive'];
      allow update: if isSchoolAdmin() && (resource.data.name in myStaffSchools() || schoolId in mySchoolIds()) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['address', 'phone', 'contactName', 'note', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // ---- Ngân hàng câu hỏi cũ — KHÔNG trang nào dùng (đề nằm ở data/ic3, sửa qua image-manager →
    // GitHub). Đóng ghi; Admin còn đọc (xuất lưu nếu cần) và xoá để dọn dung lượng.
    match /questions/{questionId} {
      allow get: if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 1000;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // ---- Kết quả bài thi ----
    match /quiz_results/{resultId} {
      // Học sinh không đăng nhập → kiểm tra schema/giá trị (điểm tính ở client, không xác thực được).
      allow create: if quizResultsOpen() &&
        request.resource.data.keys().hasOnly([
          'studentName', 'studentClass', 'studentSchool', 'category', 'level',
          'minitest', 'testName', 'score', 'correct', 'incorrect', 'skipped',
          'total', 'elapsedSec', 'tabSwitches', 'clicks', 'integrityOk',
          'flags', 'timedOut', 'submittedAt', 'expireAt'
        ]) &&
        request.resource.data.studentName is string &&
        request.resource.data.studentName.size() > 0 &&
        request.resource.data.studentName.size() < 200 &&
        request.resource.data.studentClass is string &&
        request.resource.data.studentClass.size() < 200 &&
        request.resource.data.studentSchool is string &&
        request.resource.data.studentSchool.size() > 0 &&
        request.resource.data.studentSchool.size() < 200 &&
        request.resource.data.category is string &&
        request.resource.data.level is string &&
        request.resource.data.minitest is string &&
        request.resource.data.testName is string &&
        request.resource.data.score is number &&
        request.resource.data.score >= 0 && request.resource.data.score <= 100 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 && request.resource.data.total <= 500 &&
        request.resource.data.correct is number && request.resource.data.correct >= 0 && request.resource.data.correct <= 500 &&
        request.resource.data.incorrect is number && request.resource.data.incorrect >= 0 && request.resource.data.incorrect <= 500 &&
        request.resource.data.skipped is number && request.resource.data.skipped >= 0 && request.resource.data.skipped <= 500 &&
        request.resource.data.elapsedSec is number && request.resource.data.elapsedSec >= 0 && request.resource.data.elapsedSec <= 86400 &&
        request.resource.data.tabSwitches is number && request.resource.data.tabSwitches >= 0 && request.resource.data.tabSwitches <= 10000 &&
        request.resource.data.clicks is number && request.resource.data.clicks >= 0 && request.resource.data.clicks <= 100000 &&
        request.resource.data.integrityOk is bool &&
        request.resource.data.flags is list && request.resource.data.flags.size() <= 10 &&
        request.resource.data.timedOut is bool &&
        request.resource.data.submittedAt == request.time &&
        request.resource.data.expireAt is timestamp &&
        // Không cho đặt expireAt quá xa để né TTL (400 ngày: bài cũ trong hàng đợi mang hạn 365 ngày).
        request.resource.data.expireAt < request.time + duration.value(400, 'd');

      // Đọc theo trường; query phải có limit() ≤ 10.000.
      allow get: if isOwnSchoolField('studentSchool');
      allow list: if request.query.limit <= 10000 && isOwnSchoolField('studentSchool');
      // Chỉ Admin sửa điểm; điều phối được xoá bản ghi (dọn bài test/trùng) trong trường mình.
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSchoolStaff() && inScope(resource.data, 'studentSchool', myStaffSchools()));
    }

    // ---- Kết quả MOS Practice (bản cũ) ----
    // Từ 02/11/2026 bài MOS chỉ gửi Apps Script (route mosSubmit → tab NhatKyMOS, apps/src/35-mos.gs);
    // web đã bỏ js/mos-submissions.js. Đóng ghi công khai (ai cũng ghi được → đốt hạn mức Spark),
    // giữ đọc/xoá cho bản ghi cũ tới khi TTL expireAt (45 ngày) tự dọn.
    match /mos_submissions/{submissionId} {
      allow create: if false;
      allow get: if isOwnSchoolField('studentSchool');
      allow list: if request.query.limit <= 10000 && isOwnSchoolField('studentSchool');
      allow update, delete: if isAdmin();
    }

    // ---- Đường dự phòng Phòng cả lớp (js/arena/arena-relay.js) ----
    // Cho học sinh không nối thẳng WebRTC được. Máy giáo viên ghi document phòng; mỗi học
    // sinh (đăng nhập ẩn danh) ghi đúng up/{uid} của mình. Dữ liệu tạm, TTL theo exp.
    match /arena_relay/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if (isAdmin() || isApprovedTeacher())
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['hostUid', 'exp', 'out', 'blobs'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.exp is timestamp
        && request.resource.data.exp < request.time + duration.value(1, 'd')
        && request.resource.data.out is map;
      allow update: if isSignedIn() && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.keys().hasOnly(['hostUid', 'exp', 'out', 'blobs'])
        && request.resource.data.out is map;
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;
      match /up/{uid} {
        // Chỉ máy chủ phòng đọc tin học sinh gửi.
        allow get, list: if isSignedIn()
          && get(/databases/$(database)/documents/arena_relay/$(code)).data.hostUid == request.auth.uid;
        // Chống đốt lượt ghi: at == giờ máy chủ, 2 lần ghi cách nhau > 0,5 giây (client giãn
        // ≥ 1 giây), chỉ ghi vào phòng còn hạn. Lệnh bị từ chối không tính lượt ghi.
        allow create, update: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['m', 'exp', 'at'])
          && request.resource.data.m is list && request.resource.data.m.size() <= 4
          && request.resource.data.exp is timestamp
          && request.resource.data.exp < request.time + duration.value(1, 'd')
          && request.resource.data.at == request.time
          && (resource == null || !('at' in resource.data)
              || request.time > resource.data.at + duration.value(500, 'ms'))
          && get(/databases/$(database)/documents/arena_relay/$(code)).data.exp > request.time;
        allow delete: if false;
      }
    }

    // ---- live-quiz cũ (đã chuyển sang arena.html). Đóng hẳn; dữ liệu sót do TTL dọn. ----
    match /live_hosts/{hostUid} {
      allow read, write: if false;
    }
    match /live_rooms/{roomCode}/{document=**} {
      allow read, write: if false;
    }
    match /live_rooms/{roomCode} {
      allow read, write: if false;
    }

    // ---- Roster (roster-manager.html, coordinator/teacher dashboard) ----
    // Trang học sinh đọc file tĩnh data/roster/students-active.json, không đọc Firestore.
    // courses/classes không có field trường nên điều phối truy cập toàn bộ.
    match /courses/{courseId} {
      allow get: if isAdmin() || isSchoolStaff();
      allow list: if request.query.limit <= 10000 && (isAdmin() || isSchoolStaff());
      allow write: if isAdmin() || isSchoolStaff();
    }

    match /classes/{classId} {
      allow get: if isAdmin() || isSchoolStaff();
      allow list: if request.query.limit <= 10000 && (isAdmin() || isSchoolStaff());
      allow write: if isAdmin() || isSchoolStaff();
    }

    match /students_roster/{studentId} {
      allow get: if canAccessRosterStudent();
      allow list: if request.query.limit <= 10000 && canAccessRosterStudent();
      allow create, update: if canWriteRosterStudent();
      allow delete: if canDeleteRosterStudent();
    }

    // ---- Lịch giảng dạy (teaching-schedule.html) ----
    // Admin quản lý; giáo viên đọc cả đội và sửa lịch của chính mình; điều phối giáo viên
    // chỉ đọc (ghi được mỗi teaching_travel_distances). Điều phối đào tạo không có quyền.
    match /teaching_teachers/{teacherCode} {
      allow get: if isAdmin() || isTeachingCoordinator() || isApprovedTeacher();
      allow list: if request.query.limit <= 10000 && (isAdmin() || isTeachingCoordinator() || isApprovedTeacher());
      allow write: if isAdmin();
    }
    match /teaching_weeks/{weekKey} {
      allow get: if isAdmin() || isTeachingCoordinator() || isApprovedTeacher();
      allow list: if request.query.limit <= 10000 && (isAdmin() || isTeachingCoordinator() || isApprovedTeacher());
      // Giáo viên tự nhập lịch từ Excel được tạo tuần chưa có (id = thứ Hai "YYYY-MM-DD"),
      // không sửa/xoá tuần đã có.
      allow create: if isAdmin() || (isApprovedTeacher()
        && weekKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['label', 'createdAt'])
        && request.resource.data.label is string && request.resource.data.label.size() <= 80
        && request.resource.data.createdAt == request.time);
      allow update, delete: if isAdmin();
    }
    match /teaching_schedule/{scheduleId} {
      allow get: if isAdmin() || isTeachingCoordinator() || isApprovedTeacher();
      allow list: if request.query.limit <= 10000 && (isAdmin() || isTeachingCoordinator() || isApprovedTeacher());
      // Giáo viên chỉ ghi document "<mã NV của mình>__<weekKey>".
      allow create, update: if isAdmin()
        || (isApprovedTeacher() && request.resource.data.teacherCode == myTeacherCode()
            && scheduleId == myTeacherCode() + '__' + request.resource.data.weekKey);
      allow delete: if isAdmin();
    }

    // TKB lớp. Giờ tiết: giáo viên tự sửa document của mình.
    match /teaching_timetable_periods/{teacherCode} {
      allow get: if isAdmin() || isTeachingCoordinator() || isApprovedTeacher();
      allow list: if request.query.limit <= 10000 && (isAdmin() || isTeachingCoordinator() || isApprovedTeacher());
      allow write: if isAdmin() || (isApprovedTeacher() && teacherCode == myTeacherCode());
    }
    match /teaching_timetable/{docId} {
      allow get: if isAdmin() || isTeachingCoordinator() || isApprovedTeacher();
      allow list: if request.query.limit <= 10000 && (isAdmin() || isTeachingCoordinator() || isApprovedTeacher());
      // Cùng ràng buộc mã document với teaching_schedule (khi giáo viên tự nhập lịch).
      allow create, update: if isAdmin()
        || (isApprovedTeacher() && request.resource.data.teacherCode == myTeacherCode()
            && docId == myTeacherCode() + '__' + request.resource.data.weekKey);
      allow delete: if isAdmin();
    }

    // Khoảng cách nhà → trường để tính hỗ trợ xăng xe. Giáo viên chỉ xem của mình.
    match /teaching_travel_distances/{teacherCode} {
      allow get: if isAdmin() || isTeachingCoordinator() || (isApprovedTeacher() && teacherCode == myTeacherCode());
      allow list: if request.query.limit <= 10000 && (isAdmin() || isTeachingCoordinator() || (isApprovedTeacher() && teacherCode == myTeacherCode()));
      allow write: if isAdmin() || isTeachingCoordinator();
    }

    // ---- portfolio.html: bài đăng giáo viên (đọc công khai, ảnh base64 < 900 KB) ----
    match /gvlab_posts/{postId} {
      allow get: if true;
      allow list: if request.query.limit <= 50;
      allow create: if isEditor()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.category in ['life', 'certification']
        && request.resource.data.image is string
        && request.resource.data.image.size() < 900000
        && (!('caption' in request.resource.data) || (request.resource.data.caption is string && request.resource.data.caption.size() <= 500))
        && (!('authorName' in request.resource.data) || (request.resource.data.authorName is string && request.resource.data.authorName.size() <= 200))
        && (!('likeCount' in request.resource.data) || request.resource.data.likeCount == 0);
      // Chủ bài sửa được; người khác chỉ đổi likeCount ±1.
      allow update: if isEditor() && (
        resource.data.authorUid == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && request.resource.data.likeCount is int
          && request.resource.data.likeCount >= 0
          && request.resource.data.likeCount - resource.data.get('likeCount', 0) <= 1
          && request.resource.data.likeCount - resource.data.get('likeCount', 0) >= -1)
      );
      allow delete: if isEditor() && (resource.data.authorUid == request.auth.uid || isAdmin());

      match /likes/{uid} {
        allow get: if true;
        allow list: if request.query.limit <= 200;
        allow create: if isEditor() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if isSignedIn() && uid == request.auth.uid;
        allow update: if false;
      }
      match /comments/{commentId} {
        allow get: if true;
        allow list: if request.query.limit <= 200;
        allow create: if isEditor() && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 200
          && request.resource.data.createdAt == request.time;
        allow delete: if isEditor() && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    // Chứng chỉ của từng giáo viên.
    match /gvlab_certs/{certId} {
      allow get: if true;
      allow list: if request.query.limit <= 100;
      allow create: if isEditor()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() < 120
        && request.resource.data.image is string
        && request.resource.data.image.size() < 900000;
      allow delete: if isEditor() && (resource.data.teacherUid == request.auth.uid || isAdmin());
    }

    // Hồ sơ giáo viên, id = uid. Ảnh đại diện < 300 KB.
    match /gvlab_profiles/{uid} {
      allow get: if true;
      allow list: if request.query.limit <= 500;
      allow write: if isEditor() && (uid == request.auth.uid || isAdmin())
        && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() < 300000));
    }

    // ---- Link sổ lớp của giáo viên (js/services/teacher-sync.js), 1 document / tài khoản ----
    // Chỉ so uid (không gọi myProfile() để khỏi tốn thêm 1 lượt đọc).
    match /teacher_sync/{uid} {
      allow get, delete: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'at', 'items'])
        && request.resource.data.items is map
        && request.resource.data.items.keys().hasOnly(['eduquiz_solop_v1'])
        && (!('eduquiz_solop_v1' in request.resource.data.items) || (
          request.resource.data.items.eduquiz_solop_v1 is map
          && request.resource.data.items.eduquiz_solop_v1.keys().hasOnly(['v', 'at'])
          && request.resource.data.items.eduquiz_solop_v1.v is string
          && request.resource.data.items.eduquiz_solop_v1.v.size() < 100000
          && request.resource.data.items.eduquiz_solop_v1.at is number));
    }

    // Chat nhóm cũ (đã bỏ). Admin còn đọc/xoá để dọn dữ liệu.
    match /gvlab_chat/{messageId} {
      allow get, delete: if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 500;
      allow create, update: if false;
    }
  }
}
