{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist-hosting",
    "predeploy": ["node scripts/build-hosting.mjs"],
    "ignore": [
      "firebase.json",
      "_headers",
      "**/.*",
      "**/node_modules/**",
      "**/__pycache__/**",
      "**/__tests__/**",
      "**/*.md",
      "**/Dockerfile",
      "**/docker-compose.yml",
      "firestore.rules",
      "firestore.indexes.json",
      "apps/**",
      "docs/**",
      "scripts/**",
      "server/**",
      "server-data/**",
      "tests/**",
      "web/**",
      "mos/files/powerpoint/**",
      "mos/files/word/**",
      "mos/tools/**",
      "mos/work/**",
      "mos/server.js"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/app/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/app/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/*.@(html|js|css|json|webmanifest|txt)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/VERSION",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/@(js|css|lib|data|mos)/**/*.@(html|js|mjs|css|json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/mos/api/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/bundles/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/app/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/@(img|lib|css|mos)/**/*.@(png|jpg|jpeg|webp|gif|svg|ico|woff|woff2|ttf|mp3|wav|ogg)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      },
      {
        "source": "/*.@(png|svg|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  }
}
