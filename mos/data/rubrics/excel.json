  "2": { "type": "x.colWidth", "sheet": "Instructional Hours", "cols": "B:G", "width": 12 },
  "3": { "type": "x.sparklines", "sheet": "Enrollment", "range": "I4:I9", "sparkType": "column", "scope": "Kiểm tra Sparklines dạng cột ở I4:I9." },
  "4": { "type": "x.noTable", "sheet": "Classes" },
  "5": { "type": "x.chartSheet", "name": "Graduation Chart" },
  "6": { "type": "x.chart", "sheet": "Instructional Hours", "valAxisTitle": "Hours" }
 },
 "excel-t3-p5": {
  "1": { "type": "x.rowFormula", "sheet": "Vietnam", "col": "E", "rows": [5, 21],
         "expect": { "op": "mul", "col": "D", "k": 1.60934 } },
  "2": { "type": "x.sorted", "sheet": "Asian", "rows": [5, 62], "idCol": "A", "keys": [{ "col": "B" }, { "col": "C" }] },
  "3": { "type": "x.noCF", "sheet": "Vietnam" },
