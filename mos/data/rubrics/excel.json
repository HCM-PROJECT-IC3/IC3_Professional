  "5": { "type": "x.chart", "sheet": "Vietnam", "title": "Air Miles", "legend": false, "dTable": { "showKeys": false } },
  "6": { "type": "x.newChart", "sheet": "Asian", "chartType": "barChart", "barDir": "col", "grouping": "clustered", "valCol": "D", "belowRow": 62 }
 },
 "excel-t3-p6": {
  "1": { "type": "x.freeze", "sheet": "Products", "rows": 3, "cols": 0 },
  "2": { "type": "x.align", "sheet": "Products", "cell": "A1", "horizontal": "left" },
  "3": { "type": "x.iconSet", "sheet": "Products", "range": "E4:E18", "set": "3TrafficLights1" },
