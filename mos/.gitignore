# Tệp đề PowerPoint ~460 MB: chỉ phát qua máy chủ phòng máy (Docker), không đưa lên git.
files/powerpoint/
# Bài mẫu sinh bằng tools/make-fixtures.js
tools/fixtures/
# Bài mẫu PowerPoint lưu bằng Office thật — đi kèm tệp đề PowerPoint nên cũng không đưa lên git
tools/fixtures-office/*.pptx
# Bản làm bài của học sinh trên máy chủ phòng máy (server.js)
work/
# Tệp đề Word (~31 MB, kể cả video) — như PowerPoint: chỉ phát qua máy chủ trường (Docker, ../docker-compose.yml).
# Sinh lại bằng tools/build_catalog.py từ On_Tap_Word.zip; data/sets/word-*.json vẫn trên git nên trang vẫn liệt kê đề.
files/word/
# Bài mẫu Word lưu bằng Office thật — đi kèm tệp đề Word nên cũng không đưa lên git
tools/fixtures-office/*.docx
# Bài mẫu PowerPoint/Word làm bằng Office thật qua COM (tools/fixtures-com-*.ps1) — đi kèm tệp đề nên không đưa lên git
tools/fixtures-com/*.pptx
tools/fixtures-com/*.docx
