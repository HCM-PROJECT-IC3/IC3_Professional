# Chép thành .env (không đưa lên git) rồi: docker compose up -d --build
PORT=8080
# Trùng Script Properties RELAY_TOKEN của Apps Script (chuỗi ngẫu nhiên dài, vd 32 ký tự).
GAS_RELAY_TOKEN=
GAS_BATCH=50
GAS_FLUSH_SEC=15
# Tự cập nhật trang từ GitHub (phút; 0 = tắt — vd khi đang thử thay đổi chưa đẩy lên GitHub).
SITE_SYNC_MIN=10
# Dùng ảnh dựng sẵn thay vì build: ghcr.io/hcm-project-ic3/ic3_professional/school-server:latest
SCHOOL_IMAGE=
# Chạy kèm PeerServer cho Phòng cả lớp: docker compose --profile arena up -d, rồi đặt 9000.
PEER_PUBLIC_PORT=
